colors hover:text-accent\" href=\"/companies\">Explore portfolio<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></div><div class=\"relative\"><a aria-current=\"page\" class=\"relative flex items-center gap-2 py-2 transition-colors font-semibold text-ink\" href=\"/digital-ventures\">Digital Ventures</a></div><div class=\"relative\"><a class=\"relative flex items-center gap-2 py-2 transition-colors text-muted hover:text-ink\" href=\"/partnerships\">Partnerships</a></div></nav><div class=\"flex items-center gap-3\"><a class=\"items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-ink text-white hover:bg-forest shadow-sm hover:shadow-raised h-9 px-4 hidden sm:inline-flex btn-press\" href=\"/partnerships#inquiry\">Partner with us</a><a title=\"Team login\" aria-label=\"Team login\" class=\"hidden h-9 w-9 items-center justify-center rounded-full bg-ink text-white transition-colors hover:bg-forest sm:flex focus:outline-none focus:ring-2 focus:ring-accent/20\" href=\"/admin/login\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-4 w-4\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></a><button type=\"button\" aria-expanded=\"false\" aria-controls=\"mobile-navigation\" aria-label=\"Open menu\" class=\"flex h-10 w-10 items-center justify-center rounded-md border border-line text-ink transition-colors hover:bg-sunken lg:hidden focus:outline-none focus:ring-2 focus:ring-accent/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><main id=\"main-content\" class=\"flex-1 pt-20\"><section class=\"relative overflow-hidden bg-forest py-14 text-white lg:py-24\"><div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0 opacity-20\"><svg class=\"h-full w-full\" xmlns=\"http://www.w3.org/2000/svg\"><defs><pattern id=\"tech-grid\" width=\"48\" height=\"48\" patternUnits=\"userSpaceOnUse\"><path d=\"M 48 0 L 0 0 0 48\" fill=\"none\" stroke=\"#8cff00\" stroke-width=\"0.75\"></path><circle cx=\"2\" cy=\"2\" r=\"1.2\" fill=\"#8cff00\"></circle></pattern></defs><rect width=\"100%\" height=\"100%\" fill=\"url(#tech-grid)\"></rect></svg></div><div aria-hidden=\"true\" class=\"absolute -right-24 -top-24 h-96 w-96 rounded-full bg-lime/10 blur-3xl\"></div><div class=\"page-container relative\"><div class=\"mb-8 flex flex-wrap items-center gap-3\"><span class=\"rounded-md border border-white/10 bg-white/5 px-2.5 py-1 label-caps text-on-dark\">Studio ref: JG-DV</span><span aria-hidden=\"true\" class=\"text-on-dark-muted\">/</span><span class=\"label-caps text-lime\">Sovereign tech pipeline</span></div><div class=\"grid grid-cols-1 items-end gap-10 lg:grid-cols-12\"><div class=\"flex flex-col gap-5 lg:col-span-8\"><span class=\"flex items-center gap-2.5\"><span class=\"relative flex h-2 w-2\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full bg-lime opacity-75\"></span><span class=\"relative inline-flex h-2 w-2 rounded-full bg-lime\"></span></span><span class=\"label-caps text-lime\">Venture incubation &amp; product studio</span></span><h1 class=\"max-w-4xl text-display-md font-bold tracking-tight text-white sm:text-display-lg lg:text-display-xl\">Building digital ventures for real-world needs.</h1><p class=\"max-w-2xl text-body-lg leading-relaxed text-on-dark-muted\">Jallal Group incubates proprietary digital platforms designed to resolve structural friction in African payments, urban mobility and property access.</p></div><div class=\"rounded-lg border border-white/10 bg-white/[0.04] p-6 backdrop-blur lg:col-span-4\"><div class=\"flex items-center justify-between border-b border-white/10 pb-3\"><span class=\"label-caps text-on-dark\">Studio status</span><span class=\"inline-flex items-center gap-1.5 rounded-md bg-lime/15 px-2 py-1 text-label-sm font-medium text-lime\"><span class=\"h-1.5 w-1.5 rounded-full bg-lime\"></span>Active prototyping</span></div><div class=\"grid grid-cols-2 gap-4 pt-4\"><div><div class=\"text-headline-md font-bold text-white\">03</div><div class=\"label-caps mt-1 text-on-dark-muted\">Core platforms</div></div><div><div class=\"text-headline-md font-bold text-lime\">100%</div><div class=\"label-caps mt-1 text-on-dark-muted\">Proprietary IP</div></div></div><p class=\"mt-4 border-t border-white/10 pt-4 text-body-sm leading-relaxed text-on-dark-muted\">Direct engineering allocations targeted at Sierra Leonean infrastructure gaps with regional portability.</p></div></div></div></section><section class=\"border-b border-line bg-surface py-16 lg:py-24\"><div class=\"page-container\"><div class=\"grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14\"><div class=\"order-2 lg:order-1 lg:col-span-5\"><div class=\"overflow-hidden rounded-lg border border-line bg-white p-2 shadow-card\"><div class=\"relative aspect-[16/10] overflow-hidden\"><img alt=\"Engineers reviewing architectural system diagrams in a technical studio\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(min-width: 1024px) 40vw, 100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fventures-studio.jpg&amp;w=3840&amp;q=75\"/></div></div><div class=\"mt-4 rounded-lg border border-line bg-white p-4 shadow-card\"><span class=\"label-caps text-accent\">Methodology statement</span><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Every venture begins with in-situ field observation to map analog bottlenecks before committing a single line of production code.</p></div></div><div class=\"order-1 flex flex-col gap-5 lg:order-2 lg:col-span-7\"><span class=\"label-caps inline-flex items-center gap-2 text-accent\"><span aria-hidden=\"true\" class=\"h-px w-6 bg-accent\"></span>Studio incubation framework</span><h2 class=\"text-display-md font-bold tracking-tight text-ink lg:text-headline-lg\">Grounded engineering for high-friction markets.</h2><p class=\"text-body-lg leading-relaxed text-muted\">Rather than transplanting foreign paradigms into local ecosystems, Jallal Group identifies systemic, real-world structural friction in Sierra Leone&#x27;s domestic economy. We assemble cross-functional product teams to prototype and deploy resilient digital infrastructure with discipline.</p><div class=\"grid grid-cols-1 gap-4 pt-2 md:grid-cols-3\"><article class=\"rounded-lg border border-line bg-white p-5 shadow-card\"><span class=\"label-caps text-accent\">01 / Discovery</span><h3 class=\"mt-2 text-title-md font-semibold text-ink\">Structural audit</h3><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Direct economic observation of informal cash bottlenecks, transit inefficiencies and title ambiguities.</p></article><article class=\"rounded-lg border border-line bg-white p-5 shadow-card\"><span class=\"label-caps text-accent\">02 / Architecture</span><h3 class=\"mt-2 text-title-md font-semibold text-ink\">Resilient specs</h3><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Offline-first patterns, local cloud deployments, low-bandwidth data caches and bank-grade cryptography.</p></article><article class=\"rounded-lg border border-line bg-white p-5 shadow-card\"><span class=\"label-caps text-accent\">03 / Staged deploy</span><h3 class=\"mt-2 text-title-md font-semibold text-ink\">Pragmatic rollout</h3><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Controlled sandbox deployments with enterprise counterparties before commercial scale.</p></article></div></div></div></div></section><section class=\"border-b border-line bg-white py-16 lg:py-24\"><div class=\"page-container flex flex-col gap-8\"><div class=\"flex flex-col gap-4 md:flex-row md:items-end md:justify-between\"><div data-scroll-reveal=\"0\" style=\"transition-delay:0s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0s, transform 0s ease-out 0s\"><div class=\"flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between\"><div class=\"flex max-w-3xl flex-col gap-4\"><span class=\"label-caps inline-flex items-center gap-2 text-accent\"><span aria-hidden=\"true\" class=\"h-px w-6 bg-accent\"></span>Active ventures</span><h2 class=\"font-bold tracking-tight lg:text-display-lg text-ink\">The production pipeline.</h2><p class=\"max-w-2xl leading-relaxed text-muted\">Current initiatives engineered within the Jallal Group venture studio. Development status reflects verified technical readiness — nothing here is presented as launched.</p></div></div></div></div><article id=\"jallal-pay\" class=\"scroll-mt-28 rounded-lg border border-line bg-white p-6 shadow-card transition-shadow hover:shadow-raised lg:p-10\"><div class=\"grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-10\"><div class=\"flex flex-col gap-5 lg:col-span-7\"><div class=\"flex flex-wrap items-center gap-3\"><span class=\"rounded-md bg-forest px-3 py-1.5 label-caps text-white\">01<!-- --> / <!-- -->FinTech infrastructure</span><span class=\"inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-medium bg-success-soft text-success\"><span class=\"h-1.5 w-1.5 rounded-full bg-accent\"></span>In development</span></div><div class=\"flex flex-col gap-1\"><h2 class=\"text-headline-lg font-bold tracking-tight text-ink\">Jallal Pay</h2><span class=\"label-caps text-muted\">Payments, wallet and merchant rails for West African commerce</span></div><p class=\"text-body-lg leading-relaxed text-muted\">A dedicated fintech initiative architected to provide secure, effortless digital transactions, simplified cross-network payments and digital wallet utilities for Sierra Leonean merchants and consumers — designed to remove closed-loop network friction.</p><div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2\"><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network h-5 w-5 text-accent\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><span class=\"text-title-md font-semibold text-ink\">Network agnostic</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Interoperability routing between fragmented domestic mobile money operators and conventional banking switches.</p></div><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-store h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M15 21v-5a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v5\"></path><path d=\"M17.774 10.31a1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.451 0 1.12 1.12 0 0 0-1.548 0 2.5 2.5 0 0 1-3.452 0 1.12 1.12 0 0 0-1.549 0 2.5 2.5 0 0 1-3.77-3.248l2.889-4.184A2 2 0 0 1 7 2h10a2 2 0 0 1 1.653.873l2.895 4.192a2.5 2.5 0 0 1-3.774 3.244\"></path><path d=\"M4 10.95V19a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8.05\"></path></svg><span class=\"text-title-md font-semibold text-ink\">Frictionless checkout</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Standardised QR protocols and low-latency webhook callbacks for online and retail merchants.</p></div><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-terminal h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M12 19h8\"></path><path d=\"m4 17 6-6-6-6\"></path></svg><span class=\"text-title-md font-semibold text-ink\">Developer API suite</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Documented REST endpoints, client libraries and immediate sandbox credentialing for integration partners.</p></div><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wallet h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1\"></path><path d=\"M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4\"></path></svg><span class=\"text-title-md font-semibold text-ink\">Offline micro-cash</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Cryptographically verified SMS and USSD fallback logic for localised connectivity interruptions.</p></div></div><div class=\"flex items-start gap-3 rounded-md border border-line bg-sunken p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check mt-0.5 h-5 w-5 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><div><span class=\"label-caps text-ink\">Engineering milestone</span><p class=\"mt-1 text-body-sm leading-relaxed text-muted\">Completing regulatory compliance architecture and institutional testing sandbox integrations with regional banking partners.</p></div></div><div class=\"flex flex-wrap gap-3\"><button type=\"button\" class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-ink text-white hover:bg-forest shadow-sm hover:shadow-raised h-11 px-6 w-full sm:w-auto\">Register for early venture updates</button><a class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-white text-ink border border-line hover:border-ink hover:bg-sunken h-11 px-6\" href=\"/partnerships#inquiry\">Discuss a payments integration</a></div></div><div class=\"flex flex-col gap-4 lg:col-span-5\"><div class=\"overflow-hidden rounded-lg border border-line bg-forest shadow-raised\"><div class=\"flex items-center justify-between border-b border-white/10 px-4 py-3\"><div class=\"flex items-center gap-2\"><span class=\"h-2.5 w-2.5 rounded-full bg-danger\"></span><span class=\"h-2.5 w-2.5 rounded-full bg-lime\"></span><span class=\"h-2.5 w-2.5 rounded-full bg-accent\"></span><span class=\"ml-2 label-caps text-on-dark\">jallal-core-api.yaml</span></div><span class=\"font-mono text-xs text-lime\">v0.4.2-proto</span></div><pre class=\"overflow-x-auto p-4 font-mono text-[11px] leading-relaxed text-on-dark\"><code>POST /v1/settlement/interop\nHost: sandbox.jallalpay.sl\nAuthorization: Bearer sec_sandbox_…\nContent-Type: application/json\n\n{\n  &quot;source_rail&quot;: &quot;MNO_DIRECT&quot;,\n  &quot;destination_rail&quot;: &quot;BANK_CLEARING&quot;,\n  &quot;currency&quot;: &quot;SLE&quot;,\n  &quot;amount&quot;: 2500.00,\n  &quot;offline_resilient&quot;: true,\n  &quot;verification_sig&quot;: &quot;ed25519:f9c8…44b&quot;\n}</code></pre><div class=\"flex items-center justify-between border-t border-white/10 px-4 py-3\"><span class=\"label-caps text-on-dark-muted\">Latency target</span><span class=\"font-mono text-sm font-bold text-lime\">&lt; 380ms end-to-end</span></div></div><figure class=\"overflow-hidden rounded-lg border border-line\"><div class=\"relative aspect-[16/9]\"><img alt=\"Point-of-sale terminal displaying a digital payment interface in a Bo, Sierra Leone market\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(min-width: 1024px) 36vw, 100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fjallal-pay.jpg&amp;w=3840&amp;q=75\"/></div><figcaption class=\"flex items-center justify-between gap-3 bg-white px-4 py-3 text-label-sm text-muted\"><span>FinTech infrastructure</span><span class=\"font-semibold text-ink\">Bo, Sierra Leone</span></figcaption></figure></div></div></article><article id=\"waka-salone\" class=\"scroll-mt-28 rounded-lg border border-line bg-white p-6 shadow-card transition-shadow hover:shadow-raised lg:p-10\"><div class=\"grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-10\"><div class=\"flex flex-col gap-5 lg:col-span-7\"><div class=\"flex flex-wrap items-center gap-3\"><span class=\"rounded-md bg-forest px-3 py-1.5 label-caps text-white\">02<!-- --> / <!-- -->Urban mobility technology</span><span class=\"inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-medium bg-sunken text-muted\"><span class=\"h-1.5 w-1.5 rounded-full bg-line-strong\"></span>Prototyping</span></div><div class=\"flex flex-col gap-1\"><h2 class=\"text-headline-lg font-bold tracking-tight text-ink\">Waka Salone</h2><span class=\"label-caps text-muted\">Route intelligence for Bo, Sierra Leone&#x27;s commuter corridors</span></div><p class=\"text-body-lg leading-relaxed text-muted\">A mobility platform conceived to streamline urban transit, optimise route discovery and connect commuters, drivers and fleet operators through intuitive mobile interfaces — built for Bo, Sierra Leone&#x27;s complex geography and informal transport networks.</p><div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2\"><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z\"></path><path d=\"M15 5.764v15\"></path><path d=\"M9 3.236v15\"></path></svg><span class=\"text-title-md font-semibold text-ink\">Route optimisation</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Mapping semi-formal transit nodes, congestion peaks and terrain bottlenecks along major peninsula arteries.</p></div><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check lucide-verified h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m16 9-5.5 5.5L8 12\"></path></svg><span class=\"text-title-md font-semibold text-ink\">Driver verification</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Credential checks developed with transit unions to raise physical safety standards for commuters.</p></div><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wallet h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1\"></path><path d=\"M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4\"></path></svg><span class=\"text-title-md font-semibold text-ink\">Transparent fares</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Algorithmic fare transparency that eliminates arbitrary surge pricing during adverse seasonal weather.</p></div><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg><span class=\"text-title-md font-semibold text-ink\">Krio voice navigation</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Localised voice-prompt interfaces in Krio for accessibility regardless of conventional literacy.</p></div></div><div class=\"flex items-start gap-3 rounded-md border border-line bg-sunken p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bus mt-0.5 h-5 w-5 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M8 6v6\"></path><path d=\"M15 6v6\"></path><path d=\"M2 12h19.6\"></path><path d=\"M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3\"></path><circle cx=\"7\" cy=\"18\" r=\"2\"></circle><path d=\"M9 18h5\"></path><circle cx=\"16\" cy=\"18\" r=\"2\"></circle></svg><div><span class=\"label-caps text-ink\">Development mandate</span><p class=\"mt-1 text-body-sm leading-relaxed text-muted\">Addressing everyday congestion, reducing transit wait times and improving commute predictability in Bo, Sierra Leone and connected regional corridors.</p></div></div><div class=\"flex flex-wrap gap-3\"><button type=\"button\" class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-ink text-white hover:bg-forest shadow-sm hover:shadow-raised h-11 px-6 w-full sm:w-auto\">Follow mobility development</button><a class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-white text-ink border border-line hover:border-ink hover:bg-sunken h-11 px-6\" href=\"/partnerships#inquiry\">Explore transit collaboration</a></div></div><div class=\"flex flex-col gap-4 lg:col-span-5\"><div class=\"rounded-lg border border-line bg-surface p-5 shadow-card\"><div class=\"flex items-center justify-between\"><span class=\"label-caps text-ink\">Transit node modelling</span><span class=\"font-mono text-label-sm text-accent\">Peninsula corridor</span></div><div class=\"mt-4 flex flex-col gap-4\"><div class=\"flex flex-col gap-2\"><div class=\"flex justify-between gap-3 text-body-sm\"><span class=\"text-muted\">Lumley → Central Bo</span><span class=\"font-semibold text-ink\">24 min avg</span></div><div class=\"h-1.5 w-full overflow-hidden rounded-full bg-line\"><div class=\"h-full w-3/4 rounded-full bg-accent\"></div></div></div><div class=\"flex flex-col gap-2\"><div class=\"flex justify-between gap-3 text-body-sm\"><span class=\"text-muted\">Waterloo → CBD rail telemetry</span><span class=\"font-semibold text-ink\">In modelling</span></div><div class=\"h-1.5 w-full overflow-hidden rounded-full bg-line\"><div class=\"h-full w-1/3 rounded-full bg-forest\"></div></div></div></div><p class=\"mt-4 border-t border-line pt-3 text-body-sm text-muted\">Route timings are derived from prototype field capture and remain pre-launch estimates.</p></div><figure class=\"overflow-hidden rounded-lg border border-line\"><div class=\"relative aspect-[16/9]\"><img alt=\"Aerial view of urban transit corridors winding through Bo, Sierra Leone&#x27;s coastal topography\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(min-width: 1024px) 36vw, 100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fwaka-salone.jpg&amp;w=3840&amp;q=75\"/></div><figcaption class=\"flex items-center justify-between gap-3 bg-white px-4 py-3 text-label-sm text-muted\"><span>Urban mobility technology</span><span class=\"font-semibold text-ink\">Mobility grid API</span></figcaption></figure></div></div></article><article id=\"first-home\" class=\"scroll-mt-28 rounded-lg border border-line bg-white p-6 shadow-card transition-shadow hover:shadow-raised lg:p-10\"><div class=\"grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-10\"><div class=\"flex flex-col gap-5 lg:col-span-7\"><div class=\"flex flex-wrap items-center gap-3\"><span class=\"rounded-md bg-forest px-3 py-1.5 label-caps text-white\">03<!-- --> / <!-- -->PropTech ecosystem</span><span class=\"inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-medium bg-sunken text-muted\"><span class=\"h-1.5 w-1.5 rounded-full bg-line-strong\"></span>Architecture</span></div><div class=\"flex flex-col gap-1\"><h2 class=\"text-headline-lg font-bold tracking-tight text-ink\">First Home</h2><span class=\"label-caps text-muted\">Verified land and property discovery for emerging buyers</span></div><p class=\"text-body-lg leading-relaxed text-muted\">An intelligent digital portal engineered to bring transparency to property search, land verification, rental listings and verified sales across Sierra Leone — designed to reduce conveyance fraud and title obscurity.</p><div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2\"><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-check h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"m9 15 2 2 4-4\"></path></svg><span class=\"text-title-md font-semibold text-ink\">Title verification index</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Multi-point legal due-diligence checklist cross-referencing surveyor records and cadastral deeds.</p></div><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z\"></path><path d=\"M15 5.764v15\"></path><path d=\"M9 3.236v15\"></path></svg><span class=\"text-title-md font-semibold text-ink\">GIS cadastral mapping</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">High-precision coordinate demarcation to prevent boundary overlap and land contention.</p></div><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock h-5 w-5 text-accent\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path></svg><span class=\"text-title-md font-semibold text-ink\">Digital inspection booking</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Direct scheduling channels for on-site surveyor walkthroughs without intermediary mark-ups.</p></div><div class=\"rounded-md border border-line bg-surface p-4\"><div class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building-complex lucide-building-2 h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M10 12h4\"></path><path d=\"M10 8h4\"></path><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2\"></path><path d=\"M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16\"></path></svg><span class=\"text-title-md font-semibold text-ink\">Group synergy</span></div><p class=\"mt-1.5 text-body-sm leading-relaxed text-muted\">Integrated with Jallal Properties Group for direct access to surveyed land and corporate assets.</p></div></div><div class=\"flex items-start gap-3 rounded-md border border-line bg-sunken p-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-check mt-0.5 h-5 w-5 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"m9 15 2 2 4-4\"></path></svg><div><span class=\"label-caps text-ink\">Synergy with physical assets</span><p class=\"mt-1 text-body-sm leading-relaxed text-muted\">Built in tandem with Jallal Properties Group so digital listings are backed by tangible, surveyed real-estate holdings.</p></div></div><div class=\"flex flex-wrap gap-3\"><button type=\"button\" class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-ink text-white hover:bg-forest shadow-sm hover:shadow-raised h-11 px-6 w-full sm:w-auto\">Follow propTech development</button><a class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-white text-ink border border-line hover:border-ink hover:bg-sunken h-11 px-6\" href=\"/partnerships#inquiry\">View propTech initiative</a></div></div><div class=\"flex flex-col gap-4 lg:col-span-5\"><div class=\"rounded-lg border border-line bg-surface p-5 shadow-card\"><span class=\"label-caps text-ink\">Property verification pipeline preview</span><ul class=\"mt-3 flex flex-col\"><li class=\"flex items-center justify-between gap-3 border-b border-line py-2.5 text-body-sm last:border-b-0\"><span class=\"flex items-center gap-2 text-muted\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-4 w-4 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Cadastral survey alignment</span><span class=\"font-mono text-xs font-bold text-accent\">VERIFIED</span></li><li class=\"flex items-center justify-between gap-3 border-b border-line py-2.5 text-body-sm last:border-b-0\"><span class=\"flex items-center gap-2 text-muted\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check h-4 w-4 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Ministry of Lands registry match</span><span class=\"font-mono text-xs font-bold text-accent\">VERIFIED</span></li><li class=\"flex items-center justify-between gap-3 border-b border-line py-2.5 text-body-sm last:border-b-0\"><span class=\"flex items-center gap-2 text-muted\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock h-4 w-4 text-muted\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path></svg>Digital escrow title assignment</span><span class=\"font-mono text-xs font-bold text-muted\">SANDBOX</span></li></ul></div><figure class=\"overflow-hidden rounded-lg border border-line\"><div class=\"relative aspect-[16/9]\"><img alt=\"Architectural rendering of a contemporary residential development on Bo, Sierra Leone&#x27;s hillsides\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(min-width: 1024px) 36vw, 100vw\" srcSet=\"/_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Ffirst-home.jpg&amp;w=3840&amp;q=75\"/></div><figcaption class=\"flex items-center justify-between gap-3 bg-white px-4 py-3 text-label-sm text-muted\"><span>PropTech ecosystem</span><span class=\"font-semibold text-ink\">Verified land registry</span></figcaption></figure></div></div></article></div></section><section id=\"pipeline\" class=\"border-b border-line bg-surface py-16 lg:py-24\"><div class=\"page-container\"><div class=\"flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between\"><div class=\"flex max-w-3xl flex-col gap-4\"><span class=\"label-caps inline-flex items-center gap-2 text-accent\"><span aria-hidden=\"true\" class=\"h-px w-6 bg-accent\"></span>R&amp;D horizons</span><h2 class=\"font-bold tracking-tight lg:text-display-lg text-ink\">Future digital ventures &amp; research pipeline.</h2><p class=\"max-w-2xl leading-relaxed text-muted\">The studio continuously conducts technical feasibility investigations aligned with domestic priorities and national sustainable development benchmarks. These areas are early-stage research — not launched products.</p></div></div><div class=\"mt-10 reveal-group grid grid-cols-1 gap-6 md:grid-cols-3\"><article id=\"healthtech-access\" class=\"hover-lift flex h-full scroll-mt-28 flex-col justify-between rounded-lg border border-line bg-white p-6 shadow-card hover:border-accent/40 hover:shadow-raised\"><div class=\"flex flex-col gap-4\"><span class=\"flex h-10 w-10 items-center justify-center rounded-md bg-surface text-ink\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-activity h-5 w-5\" aria-hidden=\"true\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"></path></svg></span><div><span class=\"label-caps text-muted\">Exploratory phase</span><h3 class=\"mt-1.5 text-headline-sm font-semibold text-ink\">HealthTech access tools</h3></div><p class=\"text-body-sm leading-relaxed text-muted\">Low-bandwidth telemedicine routing and pharmaceutical authenticity verification using secure packaging tokens to counter counterfeit medical supplies in rural districts.</p></div><div class=\"mt-6 flex items-center justify-between border-t border-line pt-4 label-caps text-muted\"><span>Focus: <!-- -->Supply integrity</span><span class=\"font-mono font-bold text-accent\">TRL-2 research</span></div></article><article id=\"agritech-telemetry\" class=\"hover-lift flex h-full scroll-mt-28 flex-col justify-between rounded-lg border border-line bg-white p-6 shadow-card hover:border-accent/40 hover:shadow-raised\"><div class=\"flex flex-col gap-4\"><span class=\"flex h-10 w-10 items-center justify-center rounded-md bg-surface text-ink\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-leaf h-5 w-5\" aria-hidden=\"true\"><path d=\"M11 20a10 10 0 0010-10 25.9 25.9 0 00-1.04-7.281 1 1 0 00-1.755-.325C15.833 5.5 13 5.5 9.8 6.1A7 7 0 0011 20\"></path><path d=\"M2 21a5 5 0 012.911-4.544C7.613 15.212 8.351 15.24 11 13\"></path></svg></span><div><span class=\"label-caps text-muted\">Exploratory phase</span><h3 class=\"mt-1.5 text-headline-sm font-semibold text-ink\">Agri-tech supply telemetry</h3></div><p class=\"text-body-sm leading-relaxed text-muted\">Cold-chain logistics telemetry and wholesale price-discovery tools connecting agrarian smallholders directly to commercial urban distributors.</p></div><div class=\"mt-6 flex items-center justify-between border-t border-line pt-4 label-caps text-muted\"><span>Focus: <!-- -->Post-harvest loss</span><span class=\"font-mono font-bold text-accent\">TRL-2 research</span></div></article><article id=\"renewable-iot\" class=\"hover-lift flex h-full scroll-mt-28 flex-col justify-between rounded-lg border border-line bg-white p-6 shadow-card hover:border-accent/40 hover:shadow-raised\"><div class=\"flex flex-col gap-4\"><span class=\"flex h-10 w-10 items-center justify-center rounded-md bg-surface text-ink\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sun h-5 w-5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2\"></path><path d=\"M12 20v2\"></path><path d=\"m4.93 4.93 1.41 1.41\"></path><path d=\"m17.66 17.66 1.41 1.41\"></path><path d=\"M2 12h2\"></path><path d=\"M20 12h2\"></path><path d=\"m6.34 17.66-1.41 1.41\"></path><path d=\"m19.07 4.93-1.41 1.41\"></path></svg></span><div><span class=\"label-caps text-muted\">Exploratory phase</span><h3 class=\"mt-1.5 text-headline-sm font-semibold text-ink\">Renewable energy IoT monitoring</h3></div><p class=\"text-body-sm leading-relaxed text-muted\">Embedded sensor firmware capturing generation metrics, battery storage cycles and micro-grid telemetry for off-grid solar infrastructure.</p></div><div class=\"mt-6 flex items-center justify-between border-t border-line pt-4 label-caps text-muted\"><span>Focus: <!-- -->Decentralised power</span><span class=\"font-mono font-bold text-accent\">TRL-1 ideation</span></div></article></div><div class=\"mt-8 flex flex-wrap items-center gap-3\"><a class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-white text-ink border border-line hover:border-ink hover:bg-sunken h-9 px-4\" href=\"/partnerships#inquiry\">Propose a research collaboration<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><span class=\"text-body-sm text-muted\">Research themes are tracked under venture type “<!-- -->venture-interest<!-- -->” for partner updates.</span></div></div></section><section class=\"border-b border-line bg-forest py-16 text-white lg:py-24\"><div class=\"page-container\"><div class=\"grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-12\"><div class=\"flex flex-col gap-5 lg:col-span-5\"><span class=\"label-caps inline-flex items-center gap-2 text-lime\"><span aria-hidden=\"true\" class=\"h-px w-6 bg-lime\"></span>Engineering governance</span><h2 class=\"text-headline-lg font-bold tracking-tight text-white\">Built on uncompromising principles of sovereign technology.</h2><p class=\"text-body-lg leading-relaxed text-on-dark-muted\">Every digital platform built inside Jallal Group adheres to rigorous standards of digital sovereignty, client data confidentiality and localised infrastructural resilience.</p><blockquote class=\"rounded-lg border border-white/10 bg-white/[0.04] p-4 text-body-sm leading-relaxed text-on-dark\">“We do not treat emerging-market users as edge cases for foreign server clusters. We build architectures that assume limited bandwidth, sovereign storage requirements and high-frequency real-world transactions.”</blockquote></div><div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:col-span-7\"><article class=\"rounded-lg border border-white/10 bg-white/[0.04] p-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database h-7 w-7 text-lime\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg><h3 class=\"mt-4 text-title-md font-semibold text-white\">Data sovereignty</h3><p class=\"mt-2 text-body-sm leading-relaxed text-on-dark-muted\">Citizen transactional and personal records remain hosted within verified localised nodes in line with national privacy and data localisation guidance.</p></article><article class=\"rounded-lg border border-white/10 bg-white/[0.04] p-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock h-7 w-7 text-lime\" aria-hidden=\"true\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg><h3 class=\"mt-4 text-title-md font-semibold text-white\">Zero-trust security</h3><p class=\"mt-2 text-body-sm leading-relaxed text-on-dark-muted\">Bank-grade tokenisation across every data layer, with mutual TLS authentication and role-based access control at the perimeter.</p></article><article class=\"rounded-lg border border-white/10 bg-white/[0.04] p-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bus h-7 w-7 text-lime\" aria-hidden=\"true\"><path d=\"M8 6v6\"></path><path d=\"M15 6v6\"></path><path d=\"M2 12h19.6\"></path><path d=\"M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3\"></path><circle cx=\"7\" cy=\"18\" r=\"2\"></circle><path d=\"M9 18h5\"></path><circle cx=\"16\" cy=\"18\" r=\"2\"></circle></svg><h3 class=\"mt-4 text-title-md font-semibold text-white\">Offline-first logic</h3><p class=\"mt-2 text-body-sm leading-relaxed text-on-dark-muted\">Frontends degrade gracefully. Applications cache critical ledger data locally and sync once network uplinks recover.</p></article><article class=\"rounded-lg border border-white/10 bg-white/[0.04] p-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network h-7 w-7 text-lime\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><h3 class=\"mt-4 text-title-md font-semibold text-white\">Local edge hosting</h3><p class=\"mt-2 text-body-sm leading-relaxed text-on-dark-muted\">Peering and caching layers positioned for West African users keep domestic interaction latency low and predictable.</p></article></div></div></div></section><section class=\"bg-sunken py-16 lg:py-24\"><div class=\"page-container\"><div class=\"flex flex-col gap-4 rounded-lg border border-line bg-white p-8 shadow-card lg:flex-row lg:items-center lg:justify-between lg:p-12\"><div class=\"flex max-w-2xl flex-col gap-4\"><span class=\"flex items-center gap-2.5 label-caps text-accent\"><span class=\"h-2.5 w-2.5 rounded-full bg-accent\"></span>Institutional &amp; technical engagement</span><h2 class=\"text-headline-lg font-bold tracking-tight text-ink\">Interested in co-building or piloting our digital platforms?</h2><p class=\"text-body-lg leading-relaxed text-muted\">Whether you are a financial institution seeking payment rails, an urban transit syndicate, or an investor exploring technology-enabled real assets, the venture studio invites strategic dialogue.</p></div><div class=\"flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col\"><a class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-ink text-white hover:bg-forest shadow-sm hover:shadow-raised h-12 px-7\" href=\"/partnerships#inquiry\">Open partnership dialogue</a><button type=\"button\" class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-white text-ink border border-line hover:border-ink hover:bg-sunken h-11 px-6 w-full sm:w-auto\">Request API sandbox</button></div></div><p class=\"mt-6 text-body-sm text-muted\">Interested in another area?<!-- --> <a class=\"font-semibold text-ink underline underline-offset-2 hover:text-accent\" href=\"/partnerships\">Tell us what you are building</a>.</p></div></section><section class=\"bg-forest py-16 text-white lg:py-24\"><div class=\"page-container\"><div class=\"flex flex-col items-center rounded-lg border border-white/10 bg-white/[0.04] px-6 py-12 text-center shadow-overlay md:px-12 lg:px-16 lg:py-16\"><span class=\"label-caps text-lime\">Venture studio</span><h2 class=\"mt-3 max-w-3xl text-display-md font-bold tracking-tight text-white lg:text-display-lg\">Build the next platform with us.</h2><p class=\"mt-5 max-w-2xl text-body-lg leading-relaxed text-on-dark-muted\">From fintech rails to mobility grids and property verification, we co-develop with institutions that share our standards.</p><div class=\"mt-8 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row\"><a class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-lime text-ink hover:bg-accent hover:text-white h-12 px-7\" href=\"/partnerships#inquiry\">Partner with us</a><a class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap shadow-sm hover:shadow-raised h-12 px-7 border border-white/20 bg-transparent text-white hover:bg-white hover:text-ink\" href=\"/our-companies\">Explore our companies</a></div><div class=\"mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-white/10 pt-6 text-body-sm text-on-dark-muted\"><span class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin h-4 w-4 text-lime\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Bo, Sierra Leone</span><a href=\"mailto:partnerships@jallalgroup.com\" class=\"flex items-center gap-2 transition-colors hover:text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-mail h-4 w-4 text-lime\" aria-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg>partnerships@jallalgroup.com</a><span class=\"flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock h-4 w-4 text-lime\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path></svg>Mon–Fri · 08:30–17:30 GMT</span></div></div></div></section><!--$--><!--/$--></main><footer class=\"border-t border-white/10 bg-forest text-white\"><div class=\"page-container pb-8 pt-16\"><div class=\"grid grid-cols-1 gap-10 border-b border-white/10 pb-12 md:grid-cols-2 lg:grid-cols-12 lg:gap-8\"><div class=\"flex flex-col gap-4 lg:col-span-4\"><a class=\"flex items-center gap-4\" href=\"/\"><img alt=\"Jallal Group\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"h-16 w-16 object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=64&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo.png&amp;w=128&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=128&amp;q=75\"/></a><div data-scroll-reveal=\"0\" style=\"transition-delay:0s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0s, transform 0s ease-out 0s\"><p class=\"max-w-sm text-body-sm leading-relaxed text-on-dark-muted\">A diversified, technology-driven business group building companies, digital platforms and innovative solutions for emerging markets across Sierra Leone and beyond.</p></div><div data-scroll-reveal=\"0.1\" style=\"transition-delay:0.1s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0.1s, transform 0s ease-out 0.1s\"><div class=\"flex items-center gap-2 self-start rounded-md border border-white/10 bg-white/5 px-3 py-1.5\"><span class=\"relative flex h-2 w-2\"><span class=\"absolute inline-flex h-full w-full animate-ping rounded-full bg-lime opacity-60\"></span><span class=\"relative inline-flex h-2 w-2 rounded-full bg-lime\"></span></span><span class=\"label-caps text-on-dark\">HQ · Bo, Sierra Leone</span></div></div></div><div data-scroll-reveal=\"0.1\" style=\"transition-delay:0.1s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0.1s, transform 0s ease-out 0.1s\"><div class=\"flex flex-col gap-3 lg:col-span-2\"><h3 class=\"label-caps text-lime\">Overview</h3><ul class=\"flex flex-col gap-2.5 text-body-sm text-on-dark-muted\"><li><a class=\"flex items-center gap-1.5 transition-colors hover:text-white hover:pl-1\" href=\"/\">Home<span class=\"h-px w-px bg-lime transition-all group-hover:w-2\"></span></a></li><li><a class=\"flex items-center gap-1.5 transition-colors hover:text-white hover:pl-1\" href=\"/about\">About Jallal Group<span class=\"h-px w-px bg-lime transition-all group-hover:w-2\"></span></a></li><li><a class=\"flex items-center gap-1.5 transition-colors hover:text-white hover:pl-1\" href=\"/our-companies\">Companies<span class=\"h-px w-px bg-lime transition-all group-hover:w-2\"></span></a></li><li><a class=\"flex items-center gap-1.5 transition-colors hover:text-white hover:pl-1\" href=\"/digital-ventures\">Digital Ventures<span class=\"h-px w-px bg-lime transition-all group-hover:w-2\"></span></a></li></ul></div></div><div data-scroll-reveal=\"0.1\" style=\"transition-delay:0.1s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0.1s, transform 0s ease-out 0.1s\"><div class=\"flex flex-col gap-3 lg:col-span-2\"><h3 class=\"label-caps text-lime\">Portfolio</h3><ul class=\"flex flex-col gap-2.5 text-body-sm text-on-dark-muted\"><li><a class=\"flex items-center gap-1.5 transition-colors hover:text-white hover:pl-1\" href=\"/companies/jallal-tech\">Jallal Tech<span class=\"h-px w-px bg-lime transition-all group-hover:w-2\"></span></a></li><li><a class=\"flex items-center gap-1.5 transition-colors hover:text-white hover:pl-1\" href=\"/companies/elevate-360\">Elevate 360<span class=\"h-px w-px bg-lime transition-all group-hover:w-2\"></span></a></li><li><a class=\"flex items-center gap-1.5 transition-colors hover:text-white hover:pl-1\" href=\"/companies/jallal-institute-of-technology\">Jallal Institute of Technology<span class=\"h-px w-px bg-lime transition-all group-hover:w-2\"></span></a></li><li><a class=\"flex items-center gap-1.5 transition-colors hover:text-white hover: