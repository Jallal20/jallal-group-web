{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/privacy-policy/layout,_N_T_/privacy-policy/page,_N_T_/privacy-policy"},"segmentPaths":["/_tree","/_full","/_index","/privacy-policy/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/c30924ab8079d10c3401dbb5eaba114eb2b72390cdd173117572fa9f101807d6/$/privacy-policy","owner":{"kind":"APP_PAGE","sourceRoute":"/privacy-policy/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"dx4leq_variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/d8aeca813a9ab546-s.p.18rizl4rsrl42.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo.png&amp;w=96&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/3-dqafn2i9atc.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1pcw6gskne7pf.js\"/><script src=\"/_next/static/chunks/1wnov70f88xjy.js\" async=\"\"></script><script src=\"/_next/static/chunks/3jn_x8ihwq16e.js\" async=\"\"></script><script src=\"/_next/static/chunks/41e8y3phv41bm.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2u1d16houkiyo.js\" async=\"\"></script><script src=\"/_next/static/chunks/3qfy96eoyh-ek.js\" async=\"\"></script><script src=\"/_next/static/chunks/1ht0glp30vohj.js\" async=\"\"></script><script src=\"/_next/static/chunks/2mk0e8uz19kvz.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#062b12\"/><title>Privacy Policy | Jallal Group</title><meta name=\"description\" content=\"How Jallal Group collects, uses and protects personal information submitted through this website, including partnership inquiries and venture update requests.\"/><link rel=\"author\" href=\"https://jallalgroup.workers.dev/\"/><meta name=\"author\" content=\"Jallal Group\"/><meta name=\"keywords\" content=\"Jallal Group,Sierra Leone business group,technology company Bo,digital ventures Sierra Leone,real estate Sierra Leone,technical education West Africa,business development Sierra Leone,African innovation,Jallal Group Bo Sierra Leone\"/><meta name=\"robots\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"canonical\" href=\"https://jallalgroup.workers.dev/privacy-policy\"/><meta property=\"og:title\" content=\"Jallal Group — Technology, Ventures &amp; Enterprise Growth in Sierra Leone\"/><meta property=\"og:description\" content=\"Jallal Group is a Sierra Leone-based business group building companies, digital platforms and innovative solutions across technology, education, real estate and digital ventures.\"/><meta property=\"og:url\" content=\"https://jallalgroup.workers.dev\"/><meta property=\"og:site_name\" content=\"Jallal Group\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:image\" content=\"https://jallalgroup.workers.dev//images/logo.png\"/><meta property=\"og:image:type\" content=\"image/png\"/><meta property=\"og:image:width\" content=\"512\"/><meta property=\"og:image:height\" content=\"512\"/><meta property=\"og:image:alt\" content=\"Jallal Group — official logo\"/><meta property=\"og:image\" content=\"https://jallalgroup.workers.dev//images/hero.jpg\"/><meta property=\"og:image:type\" content=\"image/jpeg\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Jallal Group — building businesses and enabling innovation\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><