080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fhero.jpg&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/10 to-transparent\"></div><div class=\"absolute inset-x-3 bottom-3 rounded-md border border-white/10 bg-white/95 p-4 shadow-card backdrop-blur\"><div class=\"flex items-center justify-between gap-3\"><span class=\"flex items-center gap-2\"><span class=\"flex h-7 w-7 items-center justify-center rounded-sm bg-forest\"><span class=\"h-2 w-2 rounded-full bg-lime\"></span></span><span class=\"label-caps text-ink\">Strategic group entity</span></span><span class=\"text-label-sm text-muted\">Bo · SL</span></div><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">Orchestrating capital, institutional governance and technical architecture across emerging markets.</p></div></div></div><div class=\"absolute -top-3 right-3 hidden items-center gap-2 rounded-md bg-forest px-3 py-2 shadow-raised sm:flex\"><span class=\"h-2 w-2 animate-pulse rounded-full bg-lime\"></span><span class=\"label-caps text-lime\">Sovereign focus</span></div></div></div></div></div></section><section class=\"border-b border-line bg-white py-16 lg:py-24 overflow-hidden\"><div class=\"page-container relative\"><div data-scroll-reveal=\"0\" style=\"transition-delay:0s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0s, transform 0s ease-out 0s\"><div class=\"grid grid-cols-1 items-end gap-8 lg:grid-cols-12 lg:gap-12\"><div class=\"lg:col-span-8\"><div class=\"flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between\"><div class=\"flex max-w-3xl flex-col gap-4\"><span class=\"label-caps inline-flex items-center gap-2 text-accent\"><span aria-hidden=\"true\" class=\"h-px w-6 bg-accent\"></span>Strategic foundation</span><h2 class=\"font-bold tracking-tight lg:text-display-lg text-ink\">Building Businesses. Developing Technology. Creating Lasting Impact.</h2><p class=\"max-w-2xl leading-relaxed text-muted\">Jallal Group is a diversified business group established to build, develop, and manage businesses, technology platforms, and strategic initiatives that respond to real economic and social opportunities.</p></div><div class=\"shrink-0\"><div class=\"flex flex-col sm:flex-row gap-4 shrink-0\"><a class=\"inline-flex items-center gap-2 rounded-md border border-line bg-white px-6 py-3 label-caps font-semibold text-ink transition-colors hover:bg-sunken hover:text-accent\" href=\"/about\">Discover Jallal Group<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-accent transition-transform group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-white text-ink border border-line hover:border-ink hover:bg-sunken h-11 px-6\" href=\"/our-companies\">Explore Our Companies</a></div></div></div></div></div></div><div data-scroll-reveal=\"0.1\" style=\"transition-delay:0.1s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0.1s, transform 0s ease-out 0.1s\"><section class=\"mt-16 border-t border-line pt-16\"><div class=\"flex flex-col gap-8 lg:flex-row lg:items-start\"><div class=\"flex-none lg:w-72 lg:shrink-0\"><h2 class=\"text-headline-md font-bold tracking-tight text-ink\">Our Foundation</h2><p class=\"mt-4 text-body-md leading-relaxed text-muted\">Four principles define how we build, invest, and operate.</p></div><div class=\"flex-1 grid grid-cols-1 gap-6 md:grid-cols-2\"><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><div class=\"flex h-10 w-10 items-center justify-center rounded-md bg-surface text-accent mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe h-5 w-5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg></div><h3 class=\"text-title-md font-semibold text-ink\">Vision and Long-Term Thinking</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">We believe sustainable businesses are built through clear vision, strategic planning, responsible leadership, and consistent execution.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><div class=\"flex h-10 w-10 items-center justify-center rounded-md bg-surface text-accent mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-terminal h-5 w-5\" aria-hidden=\"true\"><path d=\"M12 19h8\"></path><path d=\"m4 17 6-6-6-6\"></path></svg></div><h3 class=\"text-title-md font-semibold text-ink\">Technology and Innovation</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">We use technology, digital infrastructure, and innovation to improve how individuals, businesses, and institutions operate, connect, and grow.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><div class=\"flex h-10 w-10 items-center justify-center rounded-md bg-surface text-accent mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-rocket h-5 w-5\" aria-hidden=\"true\"><path d=\"M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5\"></path><path d=\"M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09\"></path><path d=\"M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z\"></path><path d=\"M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05\"></path></svg></div><h3 class=\"text-title-md font-semibold text-ink\">Entrepreneurship and Enterprise Development</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">We identify opportunities, develop business ideas, establish ventures, and build organizations with the potential for sustainable growth.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><div class=\"flex h-10 w-10 items-center justify-center rounded-md bg-surface text-accent mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check lucide-verified h-5 w-5\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m16 9-5.5 5.5L8 12\"></path></svg></div><h3 class=\"text-title-md font-semibold text-ink\">Disciplined Execution</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">We believe ideas only create value when they are translated into practical solutions through accountability, strong management, and measurable results.</p></article></div></div></section></div><div data-scroll-reveal=\"0.2\" style=\"transition-delay:0.2s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0.2s, transform 0s ease-out 0.2s\"><section class=\"mt-20 border-t border-line pt-16 bg-surface\"><div class=\"flex flex-col gap-8 lg:flex-row lg:items-start\"><div class=\"flex-none lg:w-72 lg:shrink-0\"><h2 class=\"text-headline-md font-bold tracking-tight text-ink\">Our Business Structure</h2><p class=\"mt-4 text-body-md leading-relaxed text-muted\">Jallal Group operates through distinct companies and initiatives, each with its own area of focus.</p></div><div class=\"flex-1 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4\"><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><h3 class=\"text-title-md font-semibold text-ink\">Jallal Tech</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">Technology development, software solutions, digital infrastructure, and IT services for public and private institutions.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><h3 class=\"text-title-md font-semibold text-ink\">Jallal Institute of Technology</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">Technology education, professional development, digital skills, and practical training for Sierra Leone&#x27;s next engineering generation.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><h3 class=\"text-title-md font-semibold text-ink\">Jallal Properties Group</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">Real estate, property opportunities, and property-related services connecting individuals and enterprises with verified land and housing solutions.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><h3 class=\"text-title-md font-semibold text-ink\">Elevate 360</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">Business growth, technology adoption, digital transformation, and organizational development for growing enterprises.</p></article></div><div class=\"flex-none lg:w-72 lg:shrink-0 mt-8 lg:mt-0\"><p class=\"text-body-md leading-relaxed text-muted\">The group structure allows each company to focus on its own market while benefiting from shared strategic direction and organizational leadership.</p></div></div></section></div><div data-scroll-reveal=\"0.3\" style=\"transition-delay:0.3s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0.3s, transform 0s ease-out 0.3s\"><section class=\"mt-20 border-t border-line pt-16\"><div class=\"flex flex-col lg:flex-row lg:items-center gap-12\"><div class=\"flex-1\"><h2 class=\"text-headline-md font-bold tracking-tight text-ink\">From Ideas to Sustainable Enterprises</h2><p class=\"mt-4 text-body-md leading-relaxed text-muted\">Our approach moves deliberately from insight to execution, ensuring every venture is built on a viable foundation.</p></div><div class=\"flex-1 grid grid-cols-1 gap-6\"><article class=\"flex items-start gap-4 rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all group\"><span class=\"flex shrink-0 h-10 w-10 items-center justify-center rounded-md bg-forest text-white font-mono font-bold text-sm\">01</span><div><h3 class=\"text-title-md font-semibold text-ink\">Identify</h3><p class=\"mt-1 text-body-sm leading-relaxed text-muted\">Understand real challenges, market gaps, and opportunities before committing resources.</p></div></article><article class=\"flex items-start gap-4 rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all group\"><span class=\"flex shrink-0 h-10 w-10 items-center justify-center rounded-md bg-forest text-white font-mono font-bold text-sm\">02</span><div><h3 class=\"text-title-md font-semibold text-ink\">Develop</h3><p class=\"mt-1 text-body-sm leading-relaxed text-muted\">Build practical business models, technologies, and solutions designed for local operating conditions.</p></div></article><article class=\"flex items-start gap-4 rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all group\"><span class=\"flex shrink-0 h-10 w-10 items-center justify-center rounded-md bg-forest text-white font-mono font-bold text-sm\">03</span><div><h3 class=\"text-title-md font-semibold text-ink\">Execute</h3><p class=\"mt-1 text-body-sm leading-relaxed text-muted\">Establish operational systems, teams, partnerships, and management structures that deliver results.</p></div></article><article class=\"flex items-start gap-4 rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all group\"><span class=\"flex shrink-0 h-10 w-10 items-center justify-center rounded-md bg-forest text-white font-mono font-bold text-sm\">04</span><div><h3 class=\"text-title-md font-semibold text-ink\">Scale</h3><p class=\"mt-1 text-body-sm leading-relaxed text-muted\">Strengthen performance, expand reach, and pursue sustainable long-term growth across West Africa.</p></div></article></div></div></section></div><div data-scroll-reveal=\"0.4\" style=\"transition-delay:0.4s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0.4s, transform 0s ease-out 0.4s\"><section class=\"mt-20 border-t border-line pt-16 bg-forest text-white\"><div class=\"rounded-lg border border-white/10 bg-white/[0.04] p-8 lg:p-12\"><span class=\"label-caps inline-flex items-center gap-3 text-lime\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-lime\"></span>Strategic Outlook</span><h2 class=\"mt-4 max-w-3xl text-headline-lg font-bold tracking-tight text-white lg:text-headline-md\">Our Vision for Sierra Leone and Africa</h2><p class=\"mt-5 max-w-2xl text-body-lg leading-relaxed text-on-dark-muted\">Jallal Group is being developed from Bo, Sierra Leone with an ambition to participate in Africa&#x27;s economic transformation. Our objective is to build competitive African businesses, support technology adoption, develop practical digital skills, and create opportunities for entrepreneurs and institutions across the region. We are investing in innovation and enterprise development, and establishing partnerships that support sustainable economic growth. These are strategic commitments we are working toward — not claims of achievements already made.</p></div></section></div><div data-scroll-reveal=\"0.5\" style=\"transition-delay:0.5s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0.5s, transform 0s ease-out 0.5s\"><section class=\"mt-20 border-t border-line pt-16 pb-16\"><div class=\"grid grid-cols-1 gap-8 lg:flex-row lg:items-start\"><div class=\"flex-none lg:w-72 lg:shrink-0\"><h2 class=\"text-headline-md font-bold tracking-tight text-ink\">Our Core Values</h2><p class=\"mt-4 text-body-md leading-relaxed text-muted\">Shared operating values applied equally across our subsidiaries, ventures, and partnerships.</p></div><div class=\"flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\"><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><h3 class=\"text-title-md font-semibold text-ink\">Integrity</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">Fiduciary transparency and disciplined governance in every entity, partnership, and transaction.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><h3 class=\"text-title-md font-semibold text-ink\">Innovation</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">Practical technology and new business models that solve real problems in emerging markets.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><h3 class=\"text-title-md font-semibold text-ink\">Excellence</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">World-class architecture and technical discipline applied to every subsidiary and initiative.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><h3 class=\"text-title-md font-semibold text-ink\">Accountability</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">Clear ownership, measurable results, and responsible leadership across the group.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><h3 class=\"text-title-md font-semibold text-ink\">Collaboration</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">Partnerships with entrepreneurs, institutions, and investors that create shared value.</p></article><article class=\"rounded-lg border border-line bg-white p-6 hover-lift hover:border-accent/40 transition-all\"><h3 class=\"text-title-md font-semibold text-ink\">Sustainable Growth</h3><p class=\"mt-2 text-body-sm leading-relaxed text-muted\">Long-term economic resilience built through local capacity and reinvested value.</p></article></div></div></section></div><div data-scroll-reveal=\"0.6\" style=\"transition-delay:0.6s;opacity:0;transform:translateY(12px);transition:opacity 0s ease-out 0.6s, transform 0s ease-out 0.6s\"><section class=\"mt-20 rounded-lg border border-line bg-surface p-8 lg:p-12\"><div class=\"flex flex-col items-center justify-between gap-6 sm:flex-row sm:items-center\"><div class=\"text-center sm:text-left\"><span class=\"label-caps text-accent\">Ready to work together?</span><h3 class=\"mt-2 text-headline-md font-bold tracking-tight text-ink sm:text-headline-lg\">Build the next chapter with Jallal Group.</h3></div><div class=\"flex flex-col sm:flex-row gap-4 shrink-0\"><a class=\"inline-flex items-center gap-2 rounded-md border border-line bg-white px-6 py-3 label-caps font-semibold text-ink transition-colors hover:bg-sunken hover:text-accent\" href=\"/about\">Discover Jallal Group<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 text-accent transition-transform group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-white text-ink border border-line hover:border-ink hover:bg-sunken h-11 px-6\" href=\"/our-companies\">Explore Our Companies</a></div></div></section></div></div></section><section class=\"border-b border-line bg-sunken py-16 lg:py-24\"><div class=\"page-container\"><div class=\"flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between\"><div class=\"flex max-w-3xl flex-col gap-4\"><span class=\"label-caps inline-flex items-center gap-2 text-accent\"><span aria-hidden=\"true\" class=\"h-px w-6 bg-accent\"></span>Subsidiary operating network</span><h2 class=\"font-bold tracking-tight lg:text-display-lg text-ink\">Corporate portfolio &amp; operating subsidiaries.</h2><p class=\"max-w-2xl leading-relaxed text-muted\">Four distinct enterprises driving modernisation across key economic sectors, each engineered for reliability, governance and market expansion.</p></div><div class=\"shrink-0\"><a class=\"inline-flex items-center justify-center gap-2 rounded-md font-bold uppercase tracking-[0.1em] text-[11px] leading-4 transition-all duration-200 disabled:opacity-60 disabled:pointer-events-none whitespace-nowrap bg-white text-ink border border-line hover:border-ink hover:bg-sunken h-11 px-6\" href=\"/our-companies\">View all companies</a></div></div><div class=\"mt-10 grid grid-cols-1 gap-6 md:grid-cols-2\"><article class=\"group hover-lift rounded-lg border border-line bg-white p-6 shadow-card hover:border-accent/40 hover:shadow-raised lg:p-8\"><div><div class=\"flex flex-wrap items-center justify-between gap-3 pb-4\"><span class=\"label-caps text-ink\">01<!-- --> / <!-- -->Technology &amp; Enterprise IT</span><span class=\"rounded-sm border border-line bg-surface px-2 py-0.5 text-label-sm font-medium text-muted\">Active core</span></div><h3 class=\"text-headline-md font-bold tracking-tight text-ink lg:text-headline-lg\">Jallal Tech</h3><p class=\"mt-3 text-body-md leading-relaxed text-muted\">Software development, digital solutions, enterprise IT services and data infrastructure for public and private institutions.</p><ul class=\"mt-5 grid grid-cols-1 gap-x-6 gap-y-2.5 border-t border-line pt-5 sm:grid-cols-2\"><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Enterprise platforms</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">API &amp; core systems</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Data infrastructure</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Managed cloud &amp; security</span></li></ul></div><div class=\"mt-6 flex items-center justify-between gap-4 border-t border-line pt-5\"><div class=\"flex gap-6\"><div class=\"flex flex-col\"><span class=\"text-headline-sm font-bold text-ink\">99.98%</span><span class=\"label-caps text-muted\">System SLA target</span></div><div class=\"flex flex-col\"><span class=\"text-headline-sm font-bold text-ink\">30+</span><span class=\"label-caps text-muted\">Enterprise systems</span></div></div><a class=\"flex items-center gap-1.5 text-body-sm font-semibold text-ink transition-colors hover:text-accent btn-press\" href=\"/companies/jallal-tech\">Explore company<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></article><article class=\"group hover-lift rounded-lg border border-line bg-white p-6 shadow-card hover:border-accent/40 hover:shadow-raised lg:p-8\"><div><div class=\"flex flex-wrap items-center justify-between gap-3 pb-4\"><span class=\"label-caps text-ink\">02<!-- --> / <!-- -->Commercial Acceleration</span><span class=\"rounded-sm border border-line bg-surface px-2 py-0.5 text-label-sm font-medium text-muted\">Active core</span></div><h3 class=\"text-headline-md font-bold tracking-tight text-ink lg:text-headline-lg\">Elevate 360</h3><p class=\"mt-3 text-body-md leading-relaxed text-muted\">Business growth and operational scaling — strengthening digital presence, market capture and commercial operations.</p><ul class=\"mt-5 grid grid-cols-1 gap-x-6 gap-y-2.5 border-t border-line pt-5 sm:grid-cols-2\"><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Workflow modernization</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Omnichannel growth</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Brand &amp; product strategy</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Automation consulting</span></li></ul></div><div class=\"mt-6 flex items-center justify-between gap-4 border-t border-line pt-5\"><div class=\"flex gap-6\"><div class=\"flex flex-col\"><span class=\"text-headline-sm font-bold text-ink\">140+</span><span class=\"label-caps text-muted\">Enterprises supported</span></div><div class=\"flex flex-col\"><span class=\"text-headline-sm font-bold text-ink\">3.2x</span><span class=\"label-caps text-muted\">Average productivity lift</span></div></div><a class=\"flex items-center gap-1.5 text-body-sm font-semibold text-ink transition-colors hover:text-accent btn-press\" href=\"/companies/elevate-360\">Explore company<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></article><article class=\"group hover-lift rounded-lg border border-line bg-white p-6 shadow-card hover:border-accent/40 hover:shadow-raised lg:p-8\"><div><div class=\"flex flex-wrap items-center justify-between gap-3 pb-4\"><span class=\"label-caps text-ink\">03<!-- --> / <!-- -->Technical Education &amp; Talent</span><span class=\"rounded-sm border border-line bg-surface px-2 py-0.5 text-label-sm font-medium text-muted\">Active core</span></div><h3 class=\"text-headline-md font-bold tracking-tight text-ink lg:text-headline-lg\">Jallal Institute of Technology</h3><p class=\"mt-3 text-body-md leading-relaxed text-muted\">Technical training, digital skills development and technology education for Sierra Leone&#x27;s next engineering generation.</p><ul class=\"mt-5 grid grid-cols-1 gap-x-6 gap-y-2.5 border-t border-line pt-5 sm:grid-cols-2\"><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Software development</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">UI/UX &amp; product design</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Data literacy &amp; systems</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Corporate upskilling</span></li></ul></div><div class=\"mt-6 flex items-center justify-between gap-4 border-t border-line pt-5\"><div class=\"flex gap-6\"><div class=\"flex flex-col\"><span class=\"text-headline-sm font-bold text-ink\">1,200+</span><span class=\"label-caps text-muted\">Certified graduates</span></div><div class=\"flex flex-col\"><span class=\"text-headline-sm font-bold text-ink\">88%</span><span class=\"label-caps text-muted\">Employment placement</span></div></div><a class=\"flex items-center gap-1.5 text-body-sm font-semibold text-ink transition-colors hover:text-accent btn-press\" href=\"/companies/jallal-institute-of-technology\">Explore company<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-1\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></article><article class=\"group hover-lift rounded-lg border border-line bg-white p-6 shadow-card hover:border-accent/40 hover:shadow-raised lg:p-8\"><div><div class=\"flex flex-wrap items-center justify-between gap-3 pb-4\"><span class=\"label-caps text-ink\">04<!-- --> / <!-- -->Real Estate &amp; Infrastructure</span><span class=\"rounded-sm border border-line bg-surface px-2 py-0.5 text-label-sm font-medium text-muted\">Active core</span></div><h3 class=\"text-headline-md font-bold tracking-tight text-ink lg:text-headline-lg\">Jallal Properties Group</h3><p class=\"mt-3 text-body-md leading-relaxed text-muted\">Real estate and property services connecting individuals and enterprises with modern housing, commercial space and transparent land solutions.</p><ul class=\"mt-5 grid grid-cols-1 gap-x-6 gap-y-2.5 border-t border-line pt-5 sm:grid-cols-2\"><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Residential brokerage</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Commercial leasing</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Development advisory</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check mt-0.5 h-4 w-4 shrink-0 text-accent\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span class=\"text-body-sm text-body\">Land diligence services</span></li></ul></div><div class=\"mt-6 flex items-center justify-between gap-4 border-t border-line pt-5\"><div class=\"flex gap-6\"><div class=\"flex flex-col\"><span class=\"text-headline-sm font-bold text-ink\">$18M+</span><span class=\"label-caps text-muted\">Asset transactions</span></div><div class=\"flex flex-col\"><span class=\"text-headline-sm font-bold text-ink\">100%</span><span class=\"label-caps text-muted\">Verified land records</span></div></div><a class=\"flex items-center gap-1.5 text-body-sm font-s