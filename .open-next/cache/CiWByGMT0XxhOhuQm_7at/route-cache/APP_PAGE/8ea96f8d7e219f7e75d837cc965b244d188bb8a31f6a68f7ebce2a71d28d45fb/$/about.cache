\":\"text-display-md font-bold tracking-tight text-ink lg:text-display-lg\",\"children\":\"Grounded in Sierra Leone. Built for scale.\"}],[\"$\",\"p\",null,{\"className\":\"text-body-lg leading-relaxed text-muted\",\"children\":\"Jallal Group began with a simple observation: the most durable businesses in emerging markets are the ones that solve structural problems with local insight and world-class execution. We started in software, and expanded deliberately — into education that feeds our engineering pipeline, growth services that commercialise products, property that anchors real assets, and ventures that modernise everyday systems.\"}],[\"$\",\"p\",null,{\"className\":\"text-body-md leading-relaxed text-muted\",\"children\":\"Today the group operates as a group structure with shared technology, governance and capital discipline. Each subsidiary runs with dedicated leadership and clear accountability, while drawing on the group's common infrastructure.\"}]]}]\n1d:[\"$\",\"section\",null,{\"className\":\"border-b border-line bg-forest py-16 text-white lg:py-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 gap-6 lg:grid-cols-2\",\"children\":[[\"$\",\"article\",null,{\"className\":\"rounded-lg border border-white/10 bg-white/[0.04] p-7 lg:p-9\",\"children\":[[\"$\",\"span\",null,{\"className\":\"label-caps text-lime\",\"children\":\"Our vision\"}],[\"$\",\"h2\",null,{\"className\":\"mt-3 text-headline-lg font-bold tracking-tight text-white\",\"children\":\"A sovereign, technology-driven economy for Sierra Leone and West Africa.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-body-md leading-relaxed text-on-dark-muted\",\"children\":\"We envision an ecosystem where local talent builds the infrastructure its own society depends on — where payments, mobility, property and enterprise software are engineered here, governed properly, and scaled responsibly.\"}]]}],[\"$\",\"article\